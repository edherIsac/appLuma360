{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "flutter *": "allow",
      "dart *": "allow",
      "adb *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "flutter clean": "ask",
      "rm -rf *": "deny"
    },
    "edit": {
      "*": "ask",
      "**/lib/**/*": "allow",
      "**/test/**/*": "allow",
      "**/assets/**/*": "allow",
      "**/pubspec.yaml": "ask",
      "**/android/**/*": "ask",
      "**/ios/**/*": "ask",
      ".env*": "deny",
      "**/*keystore*": "deny",
      "**/google-services.json": "deny"
    }
  },
  "formatter": false,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true
  }
}
